# Python bytecode
__pycache__/
*.py[cod]

# Claude Code local machine config (absolute paths, per-machine permissions).
# .claude/launch.json IS tracked — the dev-server definitions are shared.
.claude/settings.local.json
.claude/worktrees/

# Image masters and icon-export scratch kept at the repo root. The app loads the
# committed docs/ copies (docs/doberman.png, docs/gengar.png, docs/maddawg.png,
# docs/newicon.png); these are the larger originals plus the icon-maker page.
/doberman.png
/gengar.png
/maddawg.png
/newicon.png
/whitebgicon.png
/icons.png
/icon_test_preview.png
/make_icon.html
/slot_machine.html

# Snow removal reservation form — its own git repo, pushed to
# github.com/CGrant10/snow_removal. Lives here so .claude/launch.json can
# serve it, but is not tracked by this repo.
/snow_removal/

# Home inventory PWA — its own git repo, pushed to
# github.com/CGrant10/grant_inventory. Same arrangement as snow_removal.
/grant_inventory/

# DFL HQ fantasy football league PWA — gets its own git repo, deployed to
# GitHub Pages from that repo's root. Same arrangement as grant_inventory.
/dfl_hq/

# Unused icon exports. manifest.json uses icon-192.png, icon-512.png, and the
# maskable pair; these per-platform variants are not referenced.
docs/icon-android-*.png
docs/icon-ios-*.png
docs/icon-web-*.png
